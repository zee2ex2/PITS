@using Microsoft.EntityFrameworkCore

<div class="filter-panel">
    <div class="filter-row">
        <span class="filter-label">Categories</span>
        <div class="category-tags">
            @foreach (var cat in _categories)
            {
                <button class="tag @(_selectedCategories.Contains(cat.Id) ? "tag-active" : "")"
                        @onclick="() => ToggleCategory(cat.Id)">
                    @cat.Name
                </button>
            }
        </div>
    </div>

    <div class="filter-row">
        <span class="filter-label">Quality</span>
        <div class="dual-slider">
            <div class="slider-track">
                <div class="track-bg"></div>
                <div class="track-fill" style="left: @((QualityMin / 1000m * 100).ToString("F0"))%; width: @(((QualityMax - QualityMin) / 1000m * 100).ToString("F0"))%"></div>
                <input type="range" min="0" max="1000" step="1" @bind="QualityMin" @bind:event="oninput" class="slider-min" />
                <input type="range" min="0" max="1000" step="1" @bind="QualityMax" @bind:event="oninput" class="slider-max" />
            </div>
            <span class="range-value">@QualityMin.ToString("F0") - @QualityMax.ToString("F0")</span>
        </div>
    </div>

    <div class="filter-row">
        <span class="filter-label">Min SCU</span>
        <div class="single-slider">
            <div class="slider-single">
                <div class="track-bg"></div>
                <div class="track-fill-single" style="width: @(ScuIndex * 100 / (_scuValues.Length - 1))%"></div>
                <div class="scu-ticks">
                    <div class="tick" style="left: @(25 * 100 / 60)%"><span>0.25</span></div>
                    <div class="tick" style="left: @(36 * 100 / 60)%"><span>0.50</span></div>
                    <div class="tick" style="left: @(46 * 100 / 60)%"><span>1.5</span></div>
                </div>
                <input type="range" min="0" max="@(_scuValues.Length - 1)" step="1" @bind="ScuIndex" @bind:event="oninput" />
            </div>
            <span class="range-value">@(ScuIndex >= _scuValues.Length - 1 ? "8+" : _scuValues[ScuIndex].ToString("F2"))</span>
        </div>
    </div>

    <div class="filter-actions">
        <button class="btn btn-primary" @onclick="ApplyFilters">Apply</button>
        <button class="btn btn-secondary" @onclick="ClearFilters">Clear</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<FilterState> FiltersChanged { get; set; }

    private static readonly decimal[] _scuValues = GenerateScuValues();
    private decimal CurrentScuValue => _scuValues[_scuIndex];

    private int _scuIndex;
    private int ScuIndex
    {
        get => _scuIndex;
        set => _scuIndex = value;
    }

    private List<PITS.Models.ItemCategory> _categories = new();
    private HashSet<int> _selectedCategories = new();
    private decimal _qualityMin;
    private decimal _qualityMax = 1000;

    public decimal QualityMin
    {
        get => _qualityMin;
        set { _qualityMin = value; if (_qualityMin > _qualityMax) _qualityMin = _qualityMax; }
    }

    public decimal QualityMax
    {
        get => _qualityMax;
        set { _qualityMax = value; if (_qualityMax < _qualityMin) _qualityMax = _qualityMin; }
    }

    private static decimal[] GenerateScuValues()
    {
        var values = new List<decimal>();
        for (var v = 0m; v <= 0.25m; v += 0.01m) values.Add(v);
        for (var v = 0.27m; v <= 0.48m; v += 0.02m) values.Add(v);
        for (var v = 0.50m; v <= 1.50m; v += 0.10m) values.Add(v);
        for (var v = 2.0m; v <= 8.0m; v += 0.48m) values.Add(v);
        return values.ToArray();
    }

    [Inject] private IServiceScopeFactory ServiceScopeFactory { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<PITS.Data.AppDbContext>();
        _categories = await db.ItemCategories.OrderBy(c => c.Name).ToListAsync();
    }

    private void ToggleCategory(int catId)
    {
        if (!_selectedCategories.Remove(catId))
            _selectedCategories.Add(catId);
    }

    private void ApplyFilters()
    {
        FiltersChanged.InvokeAsync(new FilterState
        {
            CategoryIds = _selectedCategories.ToList(),
            QualityMin = _qualityMin,
            QualityMax = _qualityMax,
            ScuMin = CurrentScuValue
        });
    }

    private void ClearFilters()
    {
        _selectedCategories.Clear();
        _qualityMin = 0;
        _qualityMax = 1000;
        _scuIndex = 0;
        ApplyFilters();
    }

    public class FilterState
    {
        public List<int> CategoryIds { get; set; } = new();
        public decimal QualityMin { get; set; }
        public decimal QualityMax { get; set; }
        public decimal ScuMin { get; set; }
        public bool IsActive => CategoryIds.Count > 0 || QualityMin > 0 || QualityMax < 1000 || ScuMin > 0;
    }
}

<style>
    .filter-panel { display: flex; flex-direction: column; gap: 1rem; }
    .filter-row { display: flex; flex-direction: column; gap: 0.35rem; }
    .filter-label { font-size: 0.8rem; color: var(--muted, #94a3b8); text-transform: uppercase; letter-spacing: 0.05em; }
    .category-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
    .tag {
        padding: 0.25rem 0.6rem; border-radius: 12px; border: 1px solid var(--line, rgba(255,255,255,0.08));
        background: transparent; color: var(--muted, #94a3b8); cursor: pointer; font-size: 0.8rem;
        transition: all 0.15s;
    }
    .tag:hover { border-color: var(--accent, #a92a28); color: var(--text, #e2e8f0); }
    .tag-active { background: var(--accent, #a92a28); color: #fff; border-color: var(--accent, #a92a28); }
    .dual-slider { display: flex; align-items: center; gap: 0.75rem; }
    .slider-track { position: relative; flex: 1; height: 28px; }
    .slider-track input[type="range"] {
        position: absolute; left: 0; right: 0; width: 100%; height: 100%; margin: 0; padding: 0;
        -webkit-appearance: none; appearance: none;
        background: transparent; border: none; outline: none;
        pointer-events: none;
    }
    .slider-track input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none; width: 28px; height: 16px; border-radius: 8px;
        background: #fff; border: none;
        box-shadow: 0 0 0 1px var(--line, rgba(255,255,255,0.08));
        cursor: pointer; pointer-events: auto;
        margin-top: -5px;
    }
    .slider-track input[type="range"]::-moz-range-thumb {
        width: 28px; height: 16px; border-radius: 8px;
        background: #fff; border: none;
        box-shadow: 0 0 0 1px var(--line, rgba(255,255,255,0.08));
        cursor: pointer; pointer-events: auto;
        margin-top: -5px;
    }
    .slider-track input[type="range"]::-webkit-slider-runnable-track {
        height: 6px; background: transparent;
    }
    .slider-track input[type="range"]::-moz-range-track {
        height: 6px; background: transparent;
    }
    .slider-min { z-index: 2; }
    .slider-max { z-index: 1; }
    .track-bg {
        position: absolute; top: 50%; transform: translateY(-50%);
        left: 0; right: 0; height: 6px; border-radius: 3px;
        background: var(--line, rgba(255,255,255,0.08));
        pointer-events: none; z-index: 0;
    }
    .track-fill {
        position: absolute; top: 50%; transform: translateY(-50%);
        height: 6px; border-radius: 3px;
        background: var(--blue, #2196f3);
        pointer-events: none; z-index: 1;
    }
    .single-slider { display: flex; align-items: center; gap: 0.75rem; flex: 1; }
    .slider-single { position: relative; flex: 1; height: 28px; }
    .slider-single input[type="range"] {
        position: absolute; left: 0; right: 0; width: 100%; height: 100%; margin: 0; padding: 0;
        -webkit-appearance: none; appearance: none;
        background: transparent; border: none; outline: none;
        z-index: 2;
    }
    .slider-single input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none; width: 28px; height: 16px; border-radius: 8px;
        background: #fff; border: none;
        box-shadow: 0 0 0 1px var(--line, rgba(255,255,255,0.08));
        cursor: pointer; margin-top: -5px;
    }
    .slider-single input[type="range"]::-moz-range-thumb {
        width: 28px; height: 16px; border-radius: 8px;
        background: #fff; border: none;
        box-shadow: 0 0 0 1px var(--line, rgba(255,255,255,0.08));
        cursor: pointer; margin-top: -5px;
    }
    .slider-single input[type="range"]::-webkit-slider-runnable-track {
        height: 6px; background: transparent;
    }
    .slider-single input[type="range"]::-moz-range-track {
        height: 6px; background: transparent;
    }
    .track-fill-single {
        position: absolute; top: 50%; transform: translateY(-50%);
        left: 0; height: 6px; border-radius: 3px;
        background: var(--blue, #2196f3);
        pointer-events: none; z-index: 1;
    }
    .scu-ticks { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
    .tick {
        position: absolute; top: calc(50% + 3px); transform: translateX(-50%);
        width: 1px; height: 5px; background: var(--muted, #94a3b8);
    }
    .tick span {
        position: absolute; top: 7px; left: 50%; transform: translateX(-50%);
        font-size: 0.65rem; color: var(--muted, #94a3b8); white-space: nowrap;
    }
    .range-value { font-size: 0.85rem; color: var(--muted, #94a3b8); min-width: 100px; text-align: right; white-space: nowrap; }
    .filter-actions { display: flex; gap: 0.5rem; justify-content: flex-end; padding-top: 0.5rem; border-top: 1px solid var(--line, rgba(255,255,255,0.08)); }
</style>
